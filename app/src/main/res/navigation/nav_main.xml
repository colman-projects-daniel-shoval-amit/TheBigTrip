<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.dsa.thebigtrip.fragments.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/myPostsFragment"
        android:name="com.dsa.thebigtrip.fragments.ProfileFragment"
        android:label="My Posts" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.dsa.thebigtrip.fragments.CreatePostFragment"
        android:label="Create Post" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.dsa.thebigtrip.MapFragment"
        android:label="Map">
        <action
            android:id="@+id/action_mapFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/postDetailsFragment"
        android:name="com.dsa.thebigtrip.fragments.PostDetailsFragment"
        android:label="Post Details">
        <argument
            android:name="postId"
            app:argType="string" />
    </fragment>

</navigation>
